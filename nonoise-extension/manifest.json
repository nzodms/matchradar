{
  "manifest_version": 3,
  "name": "NoNoise",
  "version": "1.1.0",
  "description": "Cleans the web: ads, trackers, popups, cookie banners, overlays and distractions. Local-first, no account.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NoNoise",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "annoyances", "enabled": true, "path": "rules/annoyances.json" },
      { "id": "scams", "enabled": true, "path": "rules/scams.json" },
      { "id": "video", "enabled": false, "path": "rules/video.json" }
    ]
  }
}
